# Supabase Configuration
# Get these from your Supabase project dashboard → Project Settings → API
# For local development, use the values printed by `npm run supabase:start`

# Supabase project URL
# Production: https://<your-project-ref>.supabase.co
# Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase anonymous/public key (safe to commit in preview environments)
# This is the "anon" or "public" key, NOT the service role key
# Local: printed by `npm run supabase:start` in the "API Keys" section
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Rate Limiting (Optional)
# Rate limiting uses Upstash Redis when configured. Without these variables,
# the app runs in no-op mode (rate limiting disabled) for local development.
# 
# To enable rate limiting:
# 1. Create a free Upstash Redis database at https://console.upstash.com/redis
# 2. Copy the REST URL and token from the database details page
# 3. Set these variables in your production environment (e.g., Vercel)
#
# Vercel setup: Settings > Environment Variables, add both variables for Production
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Performance Monitoring (Optional)
# Token required to access the /api/diag performance diagnostic endpoint
# Only needed if you want to access the endpoint for performance metrics
PERF_TOKEN=your-secret-token

# Optional: Enable detailed performance logging
# Set to "1" to enable performance debugging logs in the console
# PERF_DEBUG=1

# Node.js environment (set by Next.js automatically, do not override)
# NODE_ENV=development

# Vercel deployment region (set by Vercel automatically, do not override)
# VERCEL_REGION=bom1
